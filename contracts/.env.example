# Copy to .env. Never commit real keys.
# Network values verified 2026-10-13 against the official BOT Chain docs (see docs/ADR-001).
BOHR_RPC_URL=https://rpc.bohr.life
BOT_RPC_URL=https://rpc.botchain.ai

# Deployer key, funded with tBOT from https://faucet.botchain.ai/basic for testnet.
PRIVATE_KEY=

# Wallet that receives the default admin role. Use a multisig for mainnet.
ADMIN_ADDRESS=
# Optional comma-separated wallets granted roles at deploy time.
INITIAL_REGISTRARS=
INITIAL_SERVICE_PROVIDERS=
