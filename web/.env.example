# Copy to .env.local. Values below are BOT Mainnet, where Vestra is deployed (see docs/DEPLOYMENTS.md).
# Network values verified 2026-10-13 against the official BOT Chain docs (see docs/ADR-001).
# Leave the five chain values empty to target a local Anvil node (chain 31337) instead.

NEXT_PUBLIC_CHAIN_ID=677
NEXT_PUBLIC_CHAIN_NAME=BOT Mainnet
NEXT_PUBLIC_RPC_URL=https://rpc.botchain.ai
NEXT_PUBLIC_EXPLORER_URL=https://scan.botchain.ai
NEXT_PUBLIC_NATIVE_SYMBOL=BOT

# Vestra registry on BOT Mainnet.
NEXT_PUBLIC_REGISTRY_ADDRESS=0x560Ec94e3c74F41F05352e535a75E2d16dFB7CdE

# "chain" reads the registry above; "fixtures" serves labeled example data with a role switcher.
NEXT_PUBLIC_DATA_SOURCE=chain

# Public URL encoded in QR codes.
NEXT_PUBLIC_SITE_URL=https://vestra-ashy.vercel.app
NEXT_PUBLIC_REPO_URL=https://github.com/Dotman-Bei/Vestra

# Gateway used to load ipfs:// metadata links for the hash check.
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/

# TEST ONLY. Comma-separated Anvil dev accounts for automated end-to-end runs. Ignored unless the chain is
# the local Anvil node (31337). Never set this for BOT Chain.
NEXT_PUBLIC_E2E_MOCK_WALLET=
