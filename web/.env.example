# Copy to .env.local. Leave chain values empty to target a local Anvil node (chain 31337).
# BOT Chain values come from the official BOT Chain docs (PRD section 19); verified 2026-10-13, see docs/ADR-001.
#
# Bohr Testnet: NEXT_PUBLIC_CHAIN_ID=968  NEXT_PUBLIC_RPC_URL=https://rpc.bohr.life   NEXT_PUBLIC_EXPLORER_URL=https://scan.bohr.life   NEXT_PUBLIC_NATIVE_SYMBOL=tBOT
# BOT Mainnet:  NEXT_PUBLIC_CHAIN_ID=677  NEXT_PUBLIC_RPC_URL=https://rpc.botchain.ai NEXT_PUBLIC_EXPLORER_URL=https://scan.botchain.ai NEXT_PUBLIC_NATIVE_SYMBOL=BOT

NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_CHAIN_NAME=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=
NEXT_PUBLIC_NATIVE_SYMBOL=

# Deployed Vestra registry contract. Empty until deployment.
NEXT_PUBLIC_REGISTRY_ADDRESS=

# "fixtures" (labeled example data, default) or "chain" (requires NEXT_PUBLIC_REGISTRY_ADDRESS).
NEXT_PUBLIC_DATA_SOURCE=fixtures

# Public URL encoded in QR codes, e.g. https://vestra.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_REPO_URL=

# Gateway used to load ipfs:// metadata links for the hash check.
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/

# TEST ONLY. Comma-separated Anvil dev accounts for automated end-to-end runs. Ignored unless the chain is
# the local Anvil node (31337). Never set this for BOT Chain.
NEXT_PUBLIC_E2E_MOCK_WALLET=
